# Orchestrator — required environment.
#
# WHAT THIS IS. Every variable this repo actually reads, enumerated from the source rather than
# remembered (`grep -oE "process\.env\.[A-Z][A-Z0-9_]+" -r src app lib scripts`). Before it existed,
# the required set was tribal knowledge and the only written record was an ad-hoc verification note
# from one afternoon.
#
# ⚠️ NO REAL VALUES IN THIS FILE, EVER. It is committed. Placeholders only.
#
# ⚠️ IN VERCEL: secrets are `sensitive` (non-readable), production + preview only — never
# `development`. The CAS team has *Enforce Sensitive Environment Variables* on, which bans dev
# creates team-wide. A PATCH cannot convert `encrypted` to `sensitive`; delete and recreate.
#
# ⚠️ THIS REPO HOLDS THE CONNECTOR CREDENTIALS AND KIRA DOES NOT. That is the seam, not an accident:
# a refresh token here is standing access to a business's entire document store and mail. Nothing
# below belongs in the Kira project.

# ─────────────────────────────────────────────────────────────────────────────
# The seam — how Kira talks to this service
# ─────────────────────────────────────────────────────────────────────────────
# Shared HMAC secret. Kira signs a connect ticket with it; this side verifies rather than trusts,
# because /api/* sits outside the session middleware and a bare ?tenant=<uuid> would let a stranger
# attach their own account to somebody else's business. MUST match Kira's ORCHESTRATOR_SECRET.
ORCHESTRATOR_SECRET=

# Caller registry (src/caller-auth.ts). JSON array of { id, secret, tenants }, where `tenants` is
# "*" or an explicit array of tenant UUIDs the caller may act for. The legacy single secret above
# stays valid with wildcard scope and shows up in logs as caller "legacy" — it exists because
# Kira is live on it and its tenants are its app users, a set too dynamic to enumerate here.
#
# Group B remediation adds DISTINCT caller identities per capability so every privileged endpoint
# names who is allowed to invoke it:
#   kira-admin    — admin-panel operations migrated from Kira (/admin/exec cohort view,
#                   reprovision). Scoped: only the operator's own tenant(s), or "*" while Kira's
#                   user set stays un-enumerable — but a SEPARATE secret from the webhook caller.
#   kira-webhook  — system-triggered operations (Stripe webhooks → arrears, usage accrual). No
#                   user session exists; tenant comes from the webhook payload.
#   kira-public   — pre-authentication operations (beta-code peek/redeem). The most restricted:
#                   only endpoints that are safe to call without any identity.
# Separate secrets per capability mean a leak of one cannot invoke the others. Generate each with
# `openssl rand -hex 32`. Placeholder only — real values live in Vercel (Sensitive).
ORCHESTRATOR_CALLERS=

# Where this service calls Kira back, and the secret it signs that call with.
CALLBACK_URL=
CALLBACK_SECRET=

# Public URL of this deployment. Used to build return links.
NEXT_PUBLIC_APP_URL=https://connect.kiraexec.com

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — the canonical store for tasks, connections and tokens
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role. Never exposed to a browser; `connections` has RLS on with no policy by design.
SUPABASE_SERVICE_ROLE_KEY=

# Management API, for migrations and project config. Token usually on disk at ~/.supabase-token.
SUPABASE_ACCESS_TOKEN=
SUPABASE_MANAGEMENT_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Kira's Supabase project — the Group B remediation boundary
# ─────────────────────────────────────────────────────────────────────────────
# Privileged operations migrated out of Kira (admin cohort views, Stripe webhook handlers,
# beta-code claims, email suppression) read KIRA's tables, not ours. This service holds the
# KIRA project's service-role key; Kira itself is being migrated OFF service-role access, so
# this key must never appear in Kira's runtime env once migration completes. See
# lib/kira-supabase.ts. Values live in Vercel (Sensitive, Production + Preview) — placeholders only here.
KIRA_SUPABASE_URL=
KIRA_SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Google — Drive, Contacts, Gmail drafts
# ─────────────────────────────────────────────────────────────────────────────
# Google Cloud console → project `kiraexec` → Clients → the Web application client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://connect.kiraexec.com/api/connect/google/callback

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft — OneDrive (files only; no mail scope is requested at any level)
# ─────────────────────────────────────────────────────────────────────────────
# entra.microsoft.com → App registrations → your app.
#   CLIENT_ID     = Overview → Application (client) ID
#   CLIENT_SECRET = Certificates & secrets → New client secret → the **Value** column.
#                   ⚠️ Shown ONCE. Navigate away and it is gone; you would add a second secret.
#                   ⚠️ Expires — 24 months maximum. When it does, every Microsoft connection stops
#                      and nothing announces it. Diary the expiry the day you create it.
#   Registration must be "Accounts in any organizational directory and personal Microsoft accounts",
#   or only your own tenant can ever connect.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=https://connect.kiraexec.com/api/connect/microsoft/callback

# The sign-in audience. LEAVE BOTH OF THESE ALONE unless you have a specific reason.
#
# `common` (the default when the override is off) accepts work/school AND personal Microsoft
# accounts, which is what every current deployment wants.
#
# ⚠️ Setting MICROSOFT_TENANT to a tenant GUID restricts the app to ONE organisation, and every other
# client's consent then fails with a Microsoft error about their account not existing in the
# directory — which reads as their problem rather than ours. That is why it is gated behind a flag:
# the value is IGNORED entirely unless the override is exactly `true`. Anything else — unset, empty,
# `false`, `TRUE`, a typo — is `common`, because the safe state should be the one you fall into by
# accident. Same shape as STRIPE_LIVE_MODE.
#
# Turning the override on WITHOUT setting a tenant throws rather than falling back to `common`:
# falling back would be broader than what was asked for.
MICROSOFT_TENANT_OVERRIDE=false
MICROSOFT_TENANT=

# ─────────────────────────────────────────────────────────────────────────────
# Xero — accounting reads
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ Xero refresh tokens ROTATE on every use, so a failed persist loses the connection permanently.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://connect.kiraexec.com/api/connect/xero/callback
# Granular scopes, space separated. Some names exist only in the broad scheme and some only in the
# granular one — see app/api/connect/xero/route.ts, which records which were accepted and rejected.
XERO_SCOPES=

# ─────────────────────────────────────────────────────────────────────────────
# Outbound mail — the compliance path everything must go through
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ NO CONNECTOR SENDS MAIL. Gmail and Graph send scopes are never requested, and two repo-wide
# guards (gmail-no-send.test.ts, graph-no-send.test.ts) assert it. Outbound goes through Resend so it
# carries the tenant's identity, the Spam Act footer, the suppression store, the AU-only jurisdiction
# guard and the approval gate.
RESEND_API_KEY=
# Only the verified subdomain is deliverable. The bare apex is NOT verified.
EMAIL_FROM=noreply@updates.corporateaisolutions.com
# Non-production safety valve: redirect every outbound message to one address.
EMAIL_REDIRECT_TO=

UNSUBSCRIBE_BASE_URL=
UNSUBSCRIBE_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Models, metering, operations
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# Per-product usage metering. NO-OP until all three are set — metering that silently does nothing is
# indistinguishable from a product that costs nothing.
USAGE_INGEST_URL=
USAGE_INGEST_TOKEN=
USAGE_PRODUCT_SLUG=orchestrator

# Comma-separated operator addresses.
ADMIN_EMAILS=

# Shared secret for scheduled routes. ⚠️ Cron and webhook routes must also be excluded from the
# middleware matcher, or they are 307'd to a login page and the job silently never runs.
CRON_SECRET=
